{
  "name": "example-contentful-theExampleApp-js",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start:watch": "nodemon ./bin/www --ignore public/",
    "start:dev": "node ./bin/www",
    "debug": "node debug ./bin/www",
    "start": "NODE_ENV=production node ./bin/www",
    "start:production": "NODE_ENV=production node ./bin/www",
    "lint": "eslint ./app.js routes bin/www lib services handlers helpers.js i18n",
    "format": "eslint --fix . --ignore public node_modules",
    "pretest": "npm run lint",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:e2e": "node test/run-e2e-test.js",
    "test:e2e:dev": "node test/run-e2e-test.js --dev",
    "test:integration": "jest test/integration",
    "test:integration:watch": "jest test/integration --watch",
    "test:unit": "jest test/unit",
    "test:unit:watch": "jest test/unit --watch",
    "cypress:open": "cypress open"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "contentful": "^10.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "lodash": "^4.17.21",
    "marked": "^14.0.0",
    "morgan": "^1.1.0"
  },
  "devDependencies": {
    "cheerio": "^1.0.0",
    "cookie": "^0.7.2",
    "cypress": "^13.13.0",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "yargs": "^17.7.2",
    "@eslint/js": "^9.12.0",
    "globals": "^15.9.0"
  }
}
