# Multi-architecture Dockerfile for Alpine Linux
# Supports: linux/386, linux/amd64, linux/arm/v6, linux/arm/v7, linux/arm64/v8, linux/ppc64le, linux/riscv64, linux/s390x
FROM alpine:3.24

WORKDIR /app

# Install Node.js and npm (available on all target architectures in Alpine 3.24)
RUN apk add --no-cache nodejs npm

WORKDIR /app

RUN npm install -g contentful-cli

COPY package.json .
RUN npm install

COPY . .

USER node
EXPOSE 3000

CMD ["npm", "run", "start:dev"]