# Multi-architecture Dockerfile for Alpine Linux
# Supports: linux/386, linux/amd64, linux/arm/v6, linux/arm/v7, linux/arm64/v8, linux/ppc64le, linux/riscv64, linux/s390x

FROM alpine:3.24

WORKDIR /app

# Install Node.js and npm (available on all target architectures in Alpine 3.24)
RUN apk add --no-cache nodejs npm

# Install contentful-cli globally
RUN npm install -g contentful-cli

# Copy package files first for better layer caching
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm ci --only=production

# Copy application code
COPY . .

# Create non-root user (works across all architectures)
RUN addgroup -g 1000 -S nodejs && \
    adduser -S -u 1000 -G nodejs nodejs

# Change ownership of app directory
RUN chown -R nodejs:nodejs /app

USER nodejs

EXPOSE 3000

CMD ["npm", "run", "start:dev"]